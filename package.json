{
  "name": "eleicoes-2026",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "data": "uv run build_dataset.py && uv run analyze.py && bun scripts/prepare-site-data.ts",
