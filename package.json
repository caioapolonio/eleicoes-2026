  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@playwright/test": "1.64.1",
    "@types/bun": "^1.4.4",
    "@types/d3": "7.4.3",
    "@types/topojson-client": "3.1.5",
    "prettier": "3.9.10",
    "prettier-plugin-astro": "1.1.1",
    "typescript": "^6"
  },
  "packageManager": "bun@1.3.14"
