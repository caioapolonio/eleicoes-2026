---
import '@fontsource-variable/newsreader'
import '@fontsource-variable/ibm-plex-sans'
import '../styles/global.css'
import CorrelationTable from '../components/CorrelationTable.astro'
import MunicipalExplorer from '../components/MunicipalExplorer.astro'
import SourcesFooter from '../components/SourcesFooter.astro'
import { CANDIDATES, models, summary } from '../lib/data'
import { fmt } from '../lib/format'

const byModel = (name: string) => models.find((m) => m.modelo === name)!
const regionOnly = byModel('Região')
const profileOnly = byModel('Renda + cor + alfabetização')

const tiles = [
  {
    candidate: CANDIDATES[0],
    label: 'Flávio Bolsonaro',
    value: fmt.pct(summary.pct_flavio),
    note: 'dos votos válidos, sem o exterior',
  },
  {
    candidate: CANDIDATES[1],
    label: 'Lula',
    value: fmt.pct(summary.pct_lula),
    note: 'dos votos válidos, sem o exterior',
  },
  {
    candidate: CANDIDATES[0],
    label: 'Municípios vencidos por Flávio',
    value: fmt.int(summary.vitorias_flavio),
    note: `de ${fmt.int(summary.municipios)} municípios`,
  },
  {
    candidate: CANDIDATES[1],
    label: 'Municípios vencidos por Lula',
    value: fmt.int(summary.vitorias_lula),
    note: `de ${fmt.int(summary.municipios)} municípios`,
  },
]

const bandCards = [
  {
    chart: 'band-renda',
    title: 'Renda domiciliar per capita',
    note: 'Média mensal do município, Censo 2022.',
  },
  {
    chart: 'band-pretos_pardos',
    title: 'Pretos e pardos na população',
    note: 'Percentual dos moradores, Censo 2022.',
  },
  {
    chart: 'band-alfabetizacao',
    title: 'Alfabetização',
    note: 'Pessoas de 15 anos ou mais que sabem ler e escrever, Censo 2022.',
  },
]

const description = `Flávio Bolsonaro teve ${fmt.pct(summary.pct_flavio)} e Lula ${fmt.pct(summary.pct_lula)} dos votos válidos no 1º turno de 2026. Como o voto se relaciona com região, renda, cor ou raça e alfabetização em cada município.`
---

<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="description" content={description} />
    <meta name="color-scheme" content="light dark" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>1º turno 2026 por município</title>
  </head>
  <body>
    <main class="page">
      <header class="hero" id="topo">
        <p class="eyebrow">Eleição presidencial · 1º turno · 4 de outubro de 2026</p>
        <h1>1º turno 2026 por município</h1>
        <p class="takeaway">
          Flávio Bolsonaro terminou à frente com <b>{fmt.pct(summary.pct_flavio)}</b> dos votos
          válidos, contra <b>{fmt.pct(summary.pct_lula)}</b> de Lula. Entre os municípios, a região
          sozinha explica <b>{fmt.share(regionOnly.r2_lula)}</b> da variação do voto em Lula; renda,
          cor ou raça e alfabetização juntas explicam <b>{fmt.share(profileOnly.r2_lula)}</b>.
        </p>
      </header>

      <section class="tiles" aria-label="Resumo nacional">
        {tiles.map((tile) => (
          <div class="card tile">
            <div class="tile-label">
              <span class="swatch" style={`background: ${tile.candidate.color}`} />
              {tile.label}
            </div>
            <div class="tile-value">{tile.value}</div>
            <p class="note">{tile.note}</p>
          </div>
        ))}
      </section>

      <section class="section" id="onde">
        <h2>Onde cada um venceu</h2>
        <p>
          A divisão regional é o traço mais forte do resultado. Lula vence com folga no Nordeste;
          Flávio, no Sul, no Centro-Oeste e no Sudeste; o Norte se divide entre os dois.
        </p>
        <div class="grid-2">
          <div class="card">
            <h3>Votos válidos por região</h3>
            <p class="note">Percentual dos votos válidos para presidente, sem o exterior.</p>
            <div class="legend">
              {CANDIDATES.map((c) => (
                <span>
                  <span class="swatch" style={`background: ${c.color}`} />
                  {c.name}
                </span>
              ))}
            </div>
            <div class="chart loading" data-chart="regions"></div>
          </div>
          <div class="card">
            <h3>Margem por estado</h3>
            <p class="note">Percentual de Flávio menos o de Lula, em pontos percentuais.</p>
            <div class="chart loading" data-chart="states"></div>
          </div>
        </div>
      </section>

      <section class="section" id="perfil">
        <h2>Voto e perfil do município</h2>
        <p>
          Municípios mais pobres, com mais pretos e pardos e com menor alfabetização votaram mais em
          Lula. Cada curva junta os municípios em dez faixas com cerca de um décimo dos votos
          válidos cada; o ponto fica na mediana da faixa.
        </p>
        <div class="legend">
          {CANDIDATES.map((c) => (
            <span>
              <span class="swatch" style={`background: ${c.color}`} />
              {c.name}
            </span>
          ))}
        </div>
        <div class="grid-3">
          {bandCards.map((card) => (
            <div class="card">
              <h3>{card.title}</h3>
              <p class="note">{card.note}</p>
              <div class="chart loading" data-chart={card.chart} />
            </div>
          ))}
        </div>
      </section>

      <section class="section" id="dentro-das-regioes">
        <h2>Dentro de cada região</h2>
        <p>
          Boa parte da relação com a renda vem da diferença entre regiões: dentro do Sul, do Sudeste
          e do Centro-Oeste ela quase desaparece. A relação com cor ou raça aparece em todas as
          regiões, mais fraca que no país todo; a com alfabetização só fica forte no Nordeste.
        </p>
        <div class="card">
          <h3>Correlação com o voto de cada candidato</h3>
          <p class="note">
            Correlação de Pearson entre municípios, ponderada por votos válidos, com a renda em
            escala logarítmica. Perto de zero, sem relação; perto de 1 ou −1, relação forte.
          </p>
          <CorrelationTable />
        </div>
      </section>

      <section class="section" id="municipio-a-municipio">
        <h2>Renda e margem, município a município</h2>
        <p>
          Cada ponto é um município. Acima da linha, Flávio teve mais votos; abaixo, Lula. Com a
          mesma renda, municípios do Nordeste ficam bem abaixo dos do Sul e do Centro-Oeste. No
          mapa, a mesma margem aparece no território, ao lado da renda.
        </p>
        <MunicipalExplorer />
      </section>

      <section class="section" id="explica">
        <h2>Quanto cada fator explica</h2>
        <p>
          Parcela da variação do voto entre municípios que cada conjunto de fatores explica numa
          regressão linear ponderada por votos válidos (R²). A região sozinha explica tanto quanto
          renda, cor ou raça e alfabetização juntas.
        </p>
        <div class="card">
          <h3>Variação explicada (R²)</h3>
          <p class="note">
            Quanto mais perto de 100%, mais o voto do município é previsto pelos fatores do modelo.
          </p>
          <div class="legend">
            {CANDIDATES.map((c) => (
              <span>
                <span class="swatch" style={`background: ${c.color}`} />
                {c.name}
              </span>
            ))}
          </div>
          <div class="chart loading" data-chart="models"></div>
        </div>
      </section>

      <SourcesFooter />
    </main>

    <script>
      import { max } from 'd3'
      import { mount } from '../lib/chart-kit'
      import { CANDIDATES, bands, models, regions, states, type BandVariable } from '../lib/data'
      import { fmt } from '../lib/format'
      import { pairedBars } from '../charts/paired-bars'
      import { stateMargins } from '../charts/state-margins'
      import { bandLines } from '../charts/bands'

      const bandMax =
        Math.ceil((max(bands, (b) => Math.max(b.pct_flavio, b.pct_lula)) ?? 0) / 10) * 10
      const bandFormat: Record<BandVariable, (v: number) => string> = {
        renda: fmt.money,
        pretos_pardos: fmt.pct0,
        alfabetizacao: fmt.pct0,
      }
      const candidateLines = (row: { pct_flavio: number; pct_lula: number }) =>
        CANDIDATES.map((c) => ({
          color: c.color,
          text: `${c.short}: ${fmt.pct(row[`pct_${c.key}`])}`,
        }))

      const charts: Record<string, (box: HTMLElement, width: number) => void> = {
        regions: (box, width) =>
          pairedBars(box, width, regions, {
            label: (r) => r.region,
            value: (r, key) => r[`pct_${key}`],
            format: fmt.pct0,
            tip: (r) => ({
              head: r.region,
              rows: [
                ...candidateLines(r),
                {
                  text: `Municípios vencidos: Flávio ${fmt.int(r.vitorias_flavio)}, Lula ${fmt.int(r.vitorias_lula)}`,
                },
                { text: `${fmt.int(r.valid_votes)} votos válidos` },
              ],
            }),
          }),
        states: (box, width) => stateMargins(box, width, states),
        models: (box, width) =>
          pairedBars(box, width, models, {
            label: (r) => r.modelo,
            value: (r, key) => r[`r2_${key}`],
            format: fmt.share,
            tip: (r) => ({
              head: r.modelo,
              rows: CANDIDATES.map((c) => ({
                color: c.color,
                text: `${c.short}: ${fmt.share(r[`r2_${c.key}`])} explicado`,
              })),
            }),
          }),
      }
      for (const variable of Object.keys(bandFormat) as BandVariable[]) {
        charts[`band-${variable}`] = (box, width) =>
          bandLines(
            box,
            width,
            bands.filter((b) => b.variavel === variable),
            bandFormat[variable],
            bandMax,
          )
      }

      document.querySelectorAll<HTMLElement>('[data-chart]').forEach((box) => {
        box.classList.remove('loading')
        mount(box, charts[box.dataset.chart!])
      })
    </script>
  </body>
</html>

<style>
  .hero {
    display: grid;
    gap: var(--gap-md);
  }

  .eyebrow {
    margin: 0;
    font-size: var(--text-caption);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--fg-muted);
  }

  h1 {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 500;
    font-size: var(--text-title);
    line-height: 1.05;
    letter-spacing: -0.01em;
    text-wrap: balance;
  }

  .takeaway {
    margin: 0;
    max-width: 62ch;
    font-size: 1.125rem;
    line-height: 1.55;
    color: var(--fg-muted);
  }

  .takeaway b {
    font-weight: 600;
    color: var(--fg);
  }

  .tiles {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 9rem), 1fr));
    gap: var(--gap-md);
    margin-top: calc(var(--gap-xl) * -0.5);
  }

  .tile-label {
    display: flex;
    align-items: center;
    gap: var(--gap-xs);
    font-size: var(--text-caption);
    color: var(--fg-muted);
  }

  .tile-value {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(2rem, 1.5rem + 2vw, 2.75rem);
    line-height: 1.05;
  }

  @media (max-width: 30rem) {
    .tile {
      padding: var(--gap-md);
    }
  }
</style>
